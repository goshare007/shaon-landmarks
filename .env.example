# ──────────────────────────────────────────
# Shaon Landmarks — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in values:
#   cp .env.example .env

# ── Site ──────────────────────────────────
# Canonical URL (no trailing slash)
VITE_SITE_URL="https://shaon-landmarks.pages.dev"

# ── EmailJS (contact form) ───────────────
# Required for the contact & newsletter forms to work.
# Sign up at https://www.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY=""
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=""

# ── Contact Info (optional, has fallbacks) ─
VITE_WHATSAPP_NUMBER="+8801712345678"
VITE_CONTACT_PHONE="+8801712345678"
VITE_CONTACT_EMAIL="info@shaonlandmarks.com"
